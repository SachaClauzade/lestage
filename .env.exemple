# Copie ce fichier en .env et remplis-le. .env n'est jamais envoyé sur GitHub.

# Supabase > ton projet > Project Settings > General > Project ID
SUPABASE_PROJECT_REF=
# supabase.com/dashboard/account/tokens > Generate new token
SUPABASE_ACCESS_TOKEN=
# resend.com/api-keys > Create API key > Full access
RESEND_API_KEY=

# discord.com/developers/applications > ton application > Bot > Reset Token
DISCORD_BOT_TOKEN=
